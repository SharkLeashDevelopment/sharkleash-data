   "summary": "Circle hooks with natural bait; no chumming for sharks within 300 ft of shore. Gulf State Park bans shark fishing on its beach and pier.",
   "drone": {
    "status": "none",
    "note": "No state drone rule found. Refuges generally ban drone launches."
   },
   "rules": [
    {
     "label": "License",
     "text": "Alabama saltwater license (16+); no shark permit."
    },
    {
     "label": "Keep",
     "text": "1 Atlantic sharpnose + 1 bonnethead + 1 other shark per person per day. Hammerheads 78\" fork length; others 54\" (no minimum for sharpnose/bonnethead)."
    },
    {
     "label": "Don't keep",
     "text": "Sandbar, silky, dusky, sand tiger, makos and other prohibited species. Tiger, lemon and hammerheads ARE harvestable here at legal size."
    },
    {
     "label": "Gear",
     "text": "Non-offset, non-stainless circle hooks with natural bait. No surf shark fishing that creates an unsafe condition for swimmers."
    },
    {
     "label": "Chumming",
     "text": "No chumming or blood-baiting for sharks within 300 ft of the shoreline or on public piers."
    },
    {
     "label": "Local",
     "text": "Gulf State Park (main beach, pier, Romar, Cotton Bayou, Alabama Point): shark fishing and shark gear prohibited. Orange Beach: city FAQs conflict; treat as possibly prohibited."
    }
   ],
