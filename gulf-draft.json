   "name": "Florida (Gulf coast)",
   "ab": "FL",
   "category": "strict",
   "lastVerified": null,
   "draft": true,
   "summary": "Same statewide rules as Florida's Atlantic side: free shore-based shark permit + Shark-Smart course (16+), circle hooks, no chumming from the beach.",
   "drone": {
    "status": "limit",
    "note": "Not banned by the state, but a drone drop counts as shore-based shark fishing (permit + gear rules apply). Gulf Islands National Seashore: no drones."
   },
   "rules": [
    {
     "label": "Permit",
     "text": "FL saltwater license + free annual Shore-based Shark Fishing permit after the Shark-Smart course, age 16+ (65+ included)."
    },
    {
     "label": "Keep",
     "text": "1 shark/person/day, 2/vessel. Blacktip, sharpnose, blacknose, bonnethead, finetooth, smoothhounds: no minimum. Bull, nurse, spinner and others: 54\" fork length."
    },
    {
     "label": "Don't land",
     "text": "Prohibited (incl. tiger, lemon, great & scalloped hammerhead, sandbar, dusky, silky, sand tiger): keep in the water, release without delay; cut the leader if needed."
    },
    {
     "label": "Gear",
     "text": "Non-offset, non-stainless circle hooks with natural bait; carry a cutting device."
    },
    {
     "label": "Chumming",
     "text": "Banned from the beach for any species."
    },
    {
     "label": "Local",
     "text": "Walton County: no intentional shark fishing on the beach or within 2,500 ft (confirm 2025 amendment). Okaloosa County beaches and Okaloosa Island Pier: no shark fishing. Gulf Islands NS: no drones; no chumming near Fort Pickens pier."
    }
   ],
   "sources": [
    {
